# Leave every variable empty to run in demo mode (no auth gating, sample data).
# With the Supabase variables set, the app runs against a real Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Team plan's price id.
STRIPE_PRICE_TEAM=
# Optional. When set, every Stripe API call goes here instead of https://api.stripe.com,
# for example http://localhost:12111 for stripe-mock.
STRIPE_API_BASE=
