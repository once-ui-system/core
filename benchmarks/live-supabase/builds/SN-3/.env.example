# Environment variables for this app. All optional: without them the app
# runs in demo mode (Supabase is not configured, nothing is gated).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Team plan's Stripe price id
STRIPE_PRICE_TEAM=
# Optional: send every Stripe API call here instead of https://api.stripe.com
# (for example http://localhost:12111 for stripe-mock)
STRIPE_API_BASE=

# Optional rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
