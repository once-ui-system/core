# Environment variables for Acme Notes. All optional: without the Supabase
# variables the app runs in demo mode (no sign-in, no gating, sample data).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode). STRIPE_PRICE_TEAM is the Team plan's price id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
# Optional: send every Stripe API call here instead of https://api.stripe.com
# STRIPE_API_BASE=http://localhost:12111

# Optional: rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
