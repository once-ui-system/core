# Environment variables. All optional: without the Supabase ones the app runs
# in demo mode (no sign-in, sample data).

# Supabase (apply supabase/migrations/*.sql in filename order first)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_TEAM=            # the Team plan's price id
# STRIPE_API_BASE=              # optional, e.g. http://localhost:12111 (stripe-mock)

# Optional rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
