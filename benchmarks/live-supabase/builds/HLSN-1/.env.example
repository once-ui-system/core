# Environment variables for Acme Notes. All optional: without the Supabase
# variables the app runs in demo mode (sample data, no sign-in, nothing gated).

# Supabase (section 8). Set all three to run against a real project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode). Billing needs the secret key and the Team price id.
STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# The Team plan's price id ($8 per member per month).
STRIPE_PRICE_TEAM=
# Optional. Sends every Stripe API call here instead of https://api.stripe.com,
# for example http://localhost:12111 with stripe-mock.
# STRIPE_API_BASE=http://localhost:12111
