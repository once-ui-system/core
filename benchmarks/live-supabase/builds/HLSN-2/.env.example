# Environment variables for Acme Notes. All optional: without them the app runs
# in demo mode (no sign-in, no gating, sample data, a notice says so).

# Supabase (email and password sign-in, organizations, invitations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode): the Team plan's checkout and webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Team plan's price id (per member, per month)
STRIPE_PRICE_TEAM=
# Optional: send every Stripe API call here instead of https://api.stripe.com
# (for example http://localhost:12111 for stripe-mock)
STRIPE_API_BASE=
