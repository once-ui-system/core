# Without any of these the app runs in demo mode: the build passes, every page
# renders, auth gating is off and a notice says Supabase is not configured.

# Supabase (Project settings > API). The anon key is public; the service role
# key is server-only and must never get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode). STRIPE_PRICE_TEAM is the Team plan's recurring price id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
# Optional: send every Stripe API call here instead of https://api.stripe.com
# (for example a local stripe-mock).
# STRIPE_API_BASE=http://localhost:12111

# Optional: rate limiting through Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
