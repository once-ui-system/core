# Environment variables for Acme Notes. All optional: without them the app
# runs in demo mode (auth gating off, sample data, a notice that Supabase is
# not configured).

# Supabase (apply supabase/migrations/*.sql in filename order first)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The price id of the Team plan
STRIPE_PRICE_TEAM=
# Optional: send every Stripe API call here instead of https://api.stripe.com
# (for example a local stripe-mock)
# STRIPE_API_BASE=http://localhost:12111

# Optional: rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
