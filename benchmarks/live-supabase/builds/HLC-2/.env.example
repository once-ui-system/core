# Leave everything empty to run in demo mode (no auth gating, sample data).
# With the Supabase variables set, the app runs against a real Supabase project.

# Supabase (sections 4 and 5)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (section 8), test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price id of the Team plan (per member per month)
STRIPE_PRICE_TEAM=
# Optional: send Stripe API calls elsewhere, e.g. a local stripe-mock at http://localhost:12111
STRIPE_API_BASE=
