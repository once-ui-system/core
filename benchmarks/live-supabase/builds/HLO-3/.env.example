# Leave all of these empty to run in demo mode (no sign-in, sample data).

# Supabase (section 4 and 5). Run supabase/migrations in filename order first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe, test mode (section 8). The Team plan's price id, e.g. price_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
# Optional: send every Stripe API call here, e.g. http://localhost:12111 for stripe-mock.
STRIPE_API_BASE=
