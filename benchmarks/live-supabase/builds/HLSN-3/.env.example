# Environment variables for this app. With none of them set the app runs in demo
# mode: nothing is gated, and a notice says Supabase is not configured.

# Supabase (section 4 and 5). Apply supabase/migrations/ to the project in order.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe, test mode (section 8). The Team plan's price id is STRIPE_PRICE_TEAM.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
# Optional: send every Stripe API call here, for example http://localhost:12111 for stripe-mock.
# STRIPE_API_BASE=
