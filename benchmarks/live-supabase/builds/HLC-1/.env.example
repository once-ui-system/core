# Leave every variable empty to run in demo mode (sample data, no sign-in, nothing gated).

# Supabase (project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the Stripe webhook to change an organization's plan.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price id of the Team plan ($8 per member per month)
STRIPE_PRICE_TEAM=
# Optional. Overrides https://api.stripe.com, e.g. http://localhost:12111 for stripe-mock.
STRIPE_API_BASE=
