# Environment variables for Acme Notes. All optional: without them the app
# runs in demo mode (no sign-in, sample data, a notice that Supabase is not
# configured).

# Supabase (auth, organizations, plans)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Team plan checkout, test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Team plan's price id ($8 per member per month)
STRIPE_PRICE_TEAM=
# Optional: send every Stripe API call here instead of https://api.stripe.com
# (for example stripe-mock at http://localhost:12111)
# STRIPE_API_BASE=

# Optional: rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
