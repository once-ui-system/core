# Leave every variable unset to run in demo mode (no sign-in, sample data).

# Supabase (section 4 and 5). Both public variables must be set to go live.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used by the Stripe webhook to change an organization's plan.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (section 8), test mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Team plan's recurring price id (per member, per month).
STRIPE_PRICE_TEAM=
# Optional. When set, every Stripe API call goes here instead of https://api.stripe.com,
# for example http://localhost:12111 for stripe-mock.
STRIPE_API_BASE=
