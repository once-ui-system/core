{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [],
    // ai/examples import the package by name, as an app does; this points
    // them at the source so the typecheck covers them.
    "paths": { "@once-ui-system/native": ["./src/index.ts"] }
  },
  "include": ["src", "test", "test-native", "demo-src", "ai/examples"]
}
