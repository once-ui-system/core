{
 "name": "RadioButton",
 "importFrom": "@once-ui-system/native",
 "purpose": "A 20pt circle, brand-filled with a dot when checked.",
 "mixins": [
  "ControlChromeProps"
 ],
 "props": {
  "checked": "boolean",
  "defaultChecked": "boolean = false",
  "value": "string",
  "onCheckedChange": "(checked: boolean) => void",
  "label": "ReactNode",
  "description": "ReactNode",
  "disabled": "boolean = false",
  "aria-label": "string",
  "style": "ViewStyle"
 },
 "resolvedMixins": {
  "ControlChromeProps": {
   "size": "TShirtSizes",
   "error": "boolean",
   "errorMessage": "ReactNode"
  }
 },
 "types": {
  "CondensedTShirtSizes": "\"s\" | \"m\" | \"l\"",
  "TShirtSizes": "CondensedTShirtSizes | \"xs\" | \"xl\""
 }
}
