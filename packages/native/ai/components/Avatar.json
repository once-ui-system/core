{
 "name": "Avatar",
 "importFrom": "@once-ui-system/native",
 "purpose": "An image, or initials on a neutral circle.",
 "mixins": [],
 "props": {
  "size": "TShirtSizes | number | Length = \"m\"",
  "value": "string",
  "src": "string",
  "loading": "boolean",
  "empty": "boolean",
  "icon": "IconName",
  "statusIndicator": "{ scheme: Schemes | \"gray\"; tone?: undefined } | { tone: Tone; scheme?: undefined }",
  "ring": "boolean | ColorScheme",
  "testID": "string",
  "style": "ViewStyle"
 },
 "resolvedMixins": {},
 "types": {
  "BuiltInIconName": "one of the names listed under Icons",
  "ColorScheme": "\"neutral\" | \"brand\" | \"accent\" | \"info\" | \"danger\" | \"warning\" | \"success\"",
  "CondensedTShirtSizes": "\"s\" | \"m\" | \"l\"",
  "IconLibraryOverrides": "{} (an app augments it to register its own icon names)",
  "IconName": "BuiltInIconName | Extract<keyof IconLibraryOverrides, string>",
  "Length": "`${number}px` | `${number}rem`",
  "Schemes": "\"blue\" | \"indigo\" | \"violet\" | \"magenta\" | \"pink\" | \"red\" | \"orange\" | \"yellow\" | \"moss\" | \"green\" | \"emerald\" | \"aqua\" | \"cyan\"",
  "Tone": "ColorScheme",
  "TShirtSizes": "CondensedTShirtSizes | \"xs\" | \"xl\""
 }
}
