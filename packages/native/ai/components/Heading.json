{
 "name": "Heading",
 "importFrom": "@once-ui-system/native",
 "purpose": "A heading, heading-strong-l by default and announced as a header",
 "mixins": [
  "SpacingProps",
  "TextProps"
 ],
 "reactNative": [
  "TextProps"
 ],
 "props": {
  "textVariant": "TextVariant = \"heading-strong-l\""
 },
 "resolvedMixins": {
  "SpacingProps": {
   "padding": "SpacingValue",
   "paddingLeft": "SpacingValue",
   "paddingRight": "SpacingValue",
   "paddingTop": "SpacingValue",
   "paddingBottom": "SpacingValue",
   "paddingX": "SpacingValue",
   "paddingY": "SpacingValue",
   "margin": "SpacingValue",
   "marginLeft": "SpacingValue",
   "marginRight": "SpacingValue",
   "marginTop": "SpacingValue",
   "marginBottom": "SpacingValue",
   "marginX": "SpacingValue",
   "marginY": "SpacingValue",
   "gap": "SpacingValue"
  },
  "TextProps": {
   "textVariant": "TextVariant",
   "family": "TextType",
   "weight": "TextWeight",
   "onBackground": "`${ColorScheme}-${ColorWeight}`",
   "onSolid": "`${ColorScheme}-${ColorWeight}`",
   "align": "\"left\" | \"center\" | \"right\" | \"justify\"",
   "truncate": "boolean",
   "style": "TextStyle | TextStyle[]"
  }
 },
 "types": {
  "ColorScheme": "\"neutral\" | \"brand\" | \"accent\" | \"info\" | \"danger\" | \"warning\" | \"success\"",
  "ColorWeight": "\"weak\" | \"medium\" | \"strong\"",
  "CondensedTShirtSizes": "\"s\" | \"m\" | \"l\"",
  "Length": "`${number}px` | `${number}rem`",
  "ResponsiveSpacingToken": "TShirtSizes",
  "SpacingToken": "StaticSpacingToken | ResponsiveSpacingToken",
  "SpacingValue": "SpacingToken | number | Length",
  "StaticSpacingToken": "\"0\" | \"1\" | \"2\" | \"4\" | \"8\" | \"12\" | \"16\" | \"20\" | \"24\" | \"32\" | \"40\" | \"48\" | \"56\" | \"64\" | \"72\" | \"80\" | \"104\" | \"128\" | \"160\"",
  "TextSize": "TShirtSizes",
  "TextType": "\"body\" | \"heading\" | \"display\" | \"label\" | \"code\"",
  "TextVariant": "`${TextType}-${TextWeight}-${TextSize}`",
  "TextWeight": "\"default\" | \"normal\" | \"medium\" | \"strong\"",
  "TShirtSizes": "CondensedTShirtSizes | \"xs\" | \"xl\""
 }
}
