{
  "name": "@once-ui-system/native",
  "version": "0.1.0-preview.1",
  "description": "Once UI for React Native (preview): core components with the same props and design tokens as @once-ui-system/core.",
  "keywords": [
    "once-ui",
    "react-native",
    "expo",
    "design system",
    "design-tokens"
  ],
  "author": "Once UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/once-ui-system/core.git",
    "directory": "packages/native"
  },
  "bugs": {
    "url": "https://github.com/once-ui-system/core/issues"
  },
  "homepage": "https://docs.once-ui.com",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ai",
    "!ai/catalog.seed.json",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node scripts/demo.mjs",
    "sync:icons": "node scripts/sync-icons.mjs",
    "check:icons": "node scripts/sync-icons.mjs --check",
    "test:native": "jest",
    "bundle:native": "node scripts/bundle-native.mjs",
    "generate:ai": "node scripts/generate-ai.cjs",
    "check:ai": "node scripts/generate-ai.cjs --check"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.79",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@jest/globals": "29.7.0",
    "@once-ui-system/foundations": "workspace:*",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "esbuild": "^0.28.2",
    "jest": "29.7.0",
    "jsdom": "^30.0.0",
    "metro": "0.87.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.87.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "rimraf": "^6.1.3",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
