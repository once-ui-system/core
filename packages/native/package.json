{
  "name": "@once-ui-system/native",
  "version": "0.1.0-preview.0",
  "description": "Once UI for React Native (preview): 15 core components with the same props and design tokens as @once-ui-system/core.",
  "keywords": [
    "once-ui",
    "react-native",
    "expo",
    "design system",
    "design-tokens"
  ],
  "author": "Once UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/once-ui-system/core.git",
    "directory": "packages/native"
  },
  "bugs": {
    "url": "https://github.com/once-ui-system/core/issues"
  },
  "homepage": "https://docs.once-ui.com",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node scripts/demo.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.79"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@once-ui-system/foundations": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.87.1",
    "react-native-web": "^0.21.4",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
