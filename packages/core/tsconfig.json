{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "declaration": true,
    // ".." rather than ".": `paths` below points ai/examples' imports of
    // @once-ui-system/fx and /blocks at those packages' sources (3.0, F8, F10).
    "rootDir": "..",
    "outDir": "./dist",
    "typeRoots": ["./types", "./node_modules/@types"],
    "paths": {
      "@/*": ["./src/*"],
      "@once-ui-system/fx": ["../fx/src/index.ts"],
      "@once-ui-system/blocks": ["../blocks/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
