{
 "functions": {
  "useField": {
   "group": "components",
   "kind": "hook",
   "signature": "() => FieldControl | null",
   "doc": "The enclosing `Field`'s state, for a custom control that wants to wire itself up."
  },
  "useNavStyle": {
   "group": "components",
   "kind": "hook",
   "signature": "() => { inNav: boolean; sizes: { readonly toggle: \"m\"; readonly text: \"s\"; readonly height: \"32\"; readonly gap: \"2\"; readonly iconGap: \"8\"; readonly section: \"xs\"; readonly group: { readonly size: \"s\"; readonly inset: \"12\"; readonly top: \"4\"; readonly bottom: \"8\"; }; } | { ...; } | { ...; }; density: NavDensity; variant: ...",
   "doc": "The look the nearest Nav set, or the defaults outside one."
  },
  "arrayMove": {
   "group": "components",
   "kind": "function",
   "signature": "<T>(items: readonly T[], from: number, to: number) => T[]",
   "doc": "Moves one entry of a copy of `items` from `from` to `to`."
  },
  "useStylePanel": {
   "group": "components",
   "kind": "hook",
   "signature": "() => StylePanelContextValue"
  },
  "useFormPending": {
   "group": "components",
   "kind": "hook",
   "signature": "() => boolean",
   "doc": "Whether the enclosing `Form` is submitting."
  },
  "useAudioLevel": {
   "group": "modules",
   "kind": "hook",
   "signature": "(source: AudioLevelSource | null | undefined) => number",
   "doc": "The loudness of `source` from 0 to 1, updated every animation frame while there is a source."
  },
  "mascotLook": {
   "group": "modules",
   "kind": "function",
   "signature": "(seed: string | number) => MascotLook",
   "doc": "A whole look from a seed: a user id, a product name, any string or number."
  },
  "workingVerbs": {
   "group": "modules",
   "kind": "value",
   "type": "readonly string[]",
   "doc": "What `WorkingIndicator` cycles through by default."
  },
  "reactionMotion": {
   "group": "modules",
   "kind": "function",
   "signature": "(option: Pick<ReactionOption, \"value\" | \"emoji\" | \"src\" | \"motion\">) => ReactionMotion",
   "doc": "The gesture a reaction plays: its own `motion`, else one that suits the emoji."
  },
  "clusterPoints": {
   "group": "map",
   "importFrom": "@once-ui-system/core/map",
   "kind": "function",
   "signature": "<T>(items: readonly T[], getPosition: (item: T) => LngLat, zoom: number, options?: MapClusterOptions) => ClusterGroup<T>[]",
   "doc": "Greedy distance clustering, the way supercluster does it, at one integer zoom."
  },
  "useMap": {
   "group": "map",
   "importFrom": "@once-ui-system/core/map",
   "kind": "hook",
   "signature": "() => MapContextValue",
   "doc": "The map these components sit in."
  },
  "DEFAULT_MAP_STYLE": {
   "group": "map",
   "importFrom": "@once-ui-system/core/map",
   "kind": "value",
   "type": "{ readonly light: \"https://tiles.openfreemap.org/styles/positron\"; readonly dark: \"https://tiles.openfreemap.org/styles/dark\"; }",
   "doc": "OpenFreeMap: OpenStreetMap vector tiles with no key, no account and no view limit, commercial use included."
  },
  "useArrowNavigation": {
   "group": "hooks",
   "kind": "hook",
   "signature": "(options: ArrowNavigationOptions) => { focusedIndex: number; setFocusedIndex: Dispatch<SetStateAction<number>>; handleKeyDown: (e: KeyboardEvent<HTMLElement>) => void; applyHighlightedState: () => void; }"
  },
  "useDebounce": {
   "group": "hooks",
   "kind": "hook",
   "signature": "<T>(value: T, delay: number) => T"
  },
  "useOgData": {
   "group": "hooks",
   "kind": "hook",
   "signature": "(url: string | null, customFetchUrl?: string, customProxyUrl?: string) => { ogData: Partial<OgData> | null; loading: boolean; }",
   "doc": "Fetches a page's Open Graph data through the app's OG fetch route and routes a cross-origin `image` and `faviconUrl` through its proxy route."
  },
  "useOgImage": {
   "group": "hooks",
   "kind": "hook",
   "signature": "(url: string | null, customFetchUrl?: string, customProxyUrl?: string) => { ogImage: string | null; loading: boolean; }"
  },
  "useHeadingLinks": {
   "group": "hooks",
   "kind": "hook",
   "signature": "() => { id: string; text: string; level: number; }[]"
  },
  "useHotkeys": {
   "group": "hooks",
   "kind": "hook",
   "signature": "(keys: string | readonly string[], callback: (event: KeyboardEvent, hotkey: string) => void, options?: UseHotkeysOptions) => void",
   "doc": "Call `callback` when a key combination is pressed."
  },
  "useInViewport": {
   "group": "hooks",
   "kind": "hook",
   "signature": "(ref: RefObject<HTMLElement | null>, options?: IntersectionObserverInit) => boolean"
  },
  "useReducedMotion": {
   "group": "hooks",
   "kind": "hook",
   "signature": "(override?: boolean | \"auto\") => MotionCapability"
  },
  "useStreamingData": {
   "group": "hooks",
   "kind": "hook",
   "signature": "<T extends Record<string, any>>(options: StreamingOptions<T>) => StreamingResult<T>"
  },
  "useStreamingViewport": {
   "group": "hooks",
   "kind": "hook",
   "signature": "<T extends Record<string, any>>(options: StreamingViewportOptions<T>) => StreamingViewportResult<T>"
  },
  "selectNavHref": {
   "group": "utils",
   "kind": "function",
   "signature": "(pathname: string, hrefs: string[]) => string | null",
   "doc": "Which of a set of hrefs a pathname is currently on."
  },
  "defaultAdapters": {
   "group": "contexts",
   "kind": "value",
   "type": "OnceUIAdapters"
  },
  "resetAdapterWarning": {
   "group": "contexts",
   "kind": "function",
   "signature": "() => void",
   "doc": "Exported for tests; resets the once-per-session latch."
  },
  "useAdapters": {
   "group": "contexts",
   "kind": "hook",
   "signature": "() => OnceUIAdapters"
  },
  "warnIfFrameworkUnadapted": {
   "group": "contexts",
   "kind": "function",
   "signature": "(adapters: OnceUIAdapters) => void"
  },
  "useDataTheme": {
   "group": "contexts",
   "kind": "hook",
   "signature": "() => DataThemeState"
  },
  "defaultChartOptions": {
   "group": "contexts",
   "kind": "value",
   "type": "ChartOptions"
  },
  "useIcons": {
   "group": "contexts",
   "kind": "hook",
   "signature": "() => { icons: IconLibrary; }"
  },
  "DEFAULT_BREAKPOINTS": {
   "group": "contexts",
   "kind": "value",
   "type": "{ readonly xs: 480; readonly s: 768; readonly m: 1024; readonly l: 1440; readonly xl: number; }"
  },
  "useLayout": {
   "group": "contexts",
   "kind": "hook",
   "signature": "() => LayoutContextType"
  },
  "useOgRoutes": {
   "group": "contexts",
   "kind": "hook",
   "signature": "() => Readonly<OgRoutes>",
   "doc": "The Open Graph routes in effect: the nearest `OgRoutesProvider`'s, or the defaults."
  },
  "useTheme": {
   "group": "contexts",
   "kind": "hook",
   "signature": "() => ThemeProviderState"
  },
  "useStyle": {
   "group": "contexts",
   "kind": "hook",
   "signature": "() => StyleProviderState"
  },
  "defaultStyleOptions": {
   "group": "contexts",
   "kind": "value",
   "type": "StyleOptions"
  },
  "useToast": {
   "group": "contexts",
   "kind": "hook",
   "signature": "() => ToastContextProps"
  },
  "createMdxComponents": {
   "group": "mdx",
   "importFrom": "@once-ui-system/core/mdx",
   "kind": "function",
   "signature": "(overrides?: Partial<MdxComponents>) => MdxComponents",
   "doc": "The default map with `overrides` applied: replace an element (`h2`, `a`, `hr`…), register an app's own components, or map a tag back to plain HTML (`{ hr: \"hr\" }`)."
  },
  "mdxComponents": {
   "group": "mdx",
   "importFrom": "@once-ui-system/core/mdx",
   "kind": "value",
   "type": "MdxComponents",
   "doc": "The default map: Markdown elements rendered with Once UI, and the common Once UI components available as tags."
  },
  "slugify": {
   "group": "mdx",
   "importFrom": "@once-ui-system/core/mdx",
   "kind": "function",
   "signature": "(text: string) => string",
   "doc": "The fragment id for a heading's text: \"Get started & deploy\" becomes \"get-started-and-deploy\"."
  },
  "textOf": {
   "group": "mdx",
   "importFrom": "@once-ui-system/core/mdx",
   "kind": "function",
   "signature": "(node: ReactNode) => string",
   "doc": "The text a reader sees in a React node, flattened."
  },
  "nextAdapters": {
   "group": "next",
   "importFrom": "@once-ui-system/core/next",
   "kind": "value",
   "type": "OnceUIAdapters"
  },
  "createOgFetchRoute": {
   "group": "next",
   "importFrom": "@once-ui-system/core/next",
   "kind": "function",
   "signature": "(options?: OgFetchRouteOptions) => OgRouteHandlers",
   "doc": "`GET /api/og/fetch?url=…` → `{ url, title, description, image, faviconUrl? }` as JSON, read from the page's Open Graph and meta tags."
  },
  "createOgProxyRoute": {
   "group": "next",
   "importFrom": "@once-ui-system/core/next",
   "kind": "function",
   "signature": "(options?: OgProxyRouteOptions) => OgRouteHandlers",
   "doc": "`GET /api/og/proxy?url=…` → the image bytes, served from your origin."
  },
  "DEFAULT_OG_IMAGE_TYPES": {
   "group": "next",
   "importFrom": "@once-ui-system/core/next",
   "kind": "value",
   "type": "readonly string[]",
   "doc": "Raster image types the proxy passes through by default."
  },
  "defineConfig": {
   "group": "config",
   "importFrom": "@once-ui-system/core/config",
   "kind": "function",
   "signature": "<T extends OnceUIConfig>(config: T & CheckedConfig<T>) => T",
   "doc": "Type an app's `once-ui.config`."
  }
 },
