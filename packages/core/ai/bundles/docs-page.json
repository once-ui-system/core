{"id":"docs-page","title":"Docs or blog article","description":"An MDX article: breadcrumb trail, title and summary, Markdown rendered through the /mdx component map, and an on-page heading nav","components":{"Column":{"group":"components","mixins":["CommonProps","DisplayProps","FlexProps","SizeProps","SpacingProps","StyleProps"],"preset":{"direction":"column"},"preferOver":"Flex with direction=\"column\"","tags":["layout","basics"],"pairsWith":["Row","Grid","Heading","Text"]},"Row":{"group":"components","mixins":["CommonProps","DisplayProps","FlexProps","SizeProps","SpacingProps","StyleProps"],"preset":{"direction":"row"},"preferOver":"Flex with direction=\"row\"","tags":["layout","basics"],"pairsWith":["Column","Grid","Text","Button"]},"Heading":{"group":"components","mixins":["CommonProps","LeafProps","TextProps"],"props":{"wrap":"CSSProperties[\"textWrap\"] = balance","opacity":"Opacity"},"tags":["typography","basics"],"pairsWith":["Text","Column","RevealFx"],"avoid":"Layout props: it takes padding, margin, flex and s={{ hide }} but no other breakpoint props, border, radius or background; wrap it in a Row for those. A key cap is Kbd"},"Text":{"group":"components","mixins":["CommonProps","LeafProps","TextProps"],"props":{"opacity":"Opacity"},"tags":["typography","basics"],"pairsWith":["Heading","Column","Row"],"avoid":"Layout props: it takes padding, margin, flex and s={{ hide }} but no other breakpoint props, border, radius or background; wrap it in a Row for those. A key cap is Kbd"},"Breadcrumbs":{"group":"components","mixins":["CommonProps","DisplayProps","FlexProps","SizeProps","SpacingProps","StyleProps"],"props":{"items":"!BreadcrumbItem[]","separator":"ReactNode = <Icon name=\"chevronRight\" size=\"xs\" />","maxItems":"number","aria-label":"string"},"tags":["navigation"],"pairsWith":["Heading","Column","SmartLink"]},"HeadingNav":{"group":"modules","mixins":["CommonProps","DisplayProps","FlexProps","SizeProps","SpacingProps","StyleProps"],"props":{"header"