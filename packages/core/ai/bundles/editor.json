s":["Flex"],"mixins":["CommonProps","DisplayProps","FlexProps","SizeProps","SpacingProps","StyleProps"],"props":{"aspectRatio":"string = original","height":"number","alt":"string = \"\"","loading":"boolean = false","objectFit":"CSSProperties[\"objectFit\"] = cover","enlarge":"boolean = false","src":"!string","unoptimized":"boolean = false","sizes":"string | number = 100vw","priority":"boolean","caption":"ReactNode","stretch":"boolean = false","fillWidth":"boolean = true","loop":"boolean = true","autoplay":"boolean = true","sound":"boolean = false","controls":"boolean = false","style":"CSSProperties","className":"string"},"tags":["media","basics"],"pairsWith":["Card","Column","TiltFx"],"avoid":"Raw img elements"},"MediaVideoPlayer":{"group":"components","importFrom":"@once-ui-system/core/components/MediaVideoPlayer","props":{"src":"!string","autoplay":"boolean = false","loop":"boolean = false","muted":"boolean = true","objectFit":"CSSProperties[\"objectFit\"] = cover","className":"string"},"tags":["media"],"pairsWith":["Media","Column"]}},"recipes":[],"layout":"layouts.md#3-editor-shell","example":"examples/editor.tsx","gotchas":{"Timeline.notScrubber":"Timeline lays a sequence of steps down the page. For a video or audio editor's timeline — a playhead over stacked tracks of movable, trimmable blocks — use Scrubber. Do not build one out of Flex and absolute positioning.","layout.shorthands":"Use fill not fillWidth fillHeight; center not horizontal=\"center\" vertical=\"center\"; Row/Column not Flex direction=, and Row for a Flex with no direction (Flex defaults to row). Flex is for a direction that changes at a breakpoint.","zIndex.scope":"zIndex is for an isolated stacking group: an absolute decorative layer and its content sibling (zIndex={1}), or a sticky header over its pane. Never on a lone element, never a page-wide ladder of 3 / 5 / 9 — restructure the tree instead.","Icon.names":"Icon names must come from iconNames in catalog.json (spec.json has the same list), and IconName is a real union in 2.0 (an unregistered name is a type error, not a blank space). Do not guess a plausible name, and do not cast one with `as IconName` to silence the check. Brand marks are not in the set — an app registers those itself by augmenting IconLibraryOverrides.","layout.responsiveProps":"Responsive xl/l/m/s/xs props exist only on Flex, Row, Column and Grid. Button, Text, Heading and the rest have none: to change one at a breakpoint, wrap it in a Row or Column and put the breakpoint prop there (s={{ hide: true }}). Text and Heading take padding but no radius, border or flex; put those on the wrapper.","size.rem":"A number on width, height, minWidth or minHeight is rem, not px: width={32} is 512 px. For a pixel size write the spacing token string, width=\"32\" (32 px), or the rem value, width={2}. Token strings stop at the spacing scale (\"160\" is the largest), so height=\"320\" is a type error: write height={20}. An icon or avatar box is usually \"24\" to \"48\".","spacing.tokens":"gap, padding and margin take spacing tokens (\"0\", \"1\", \"2\", \"4\", \"8\", \"12\", \"16\", \"20\", \"24\", \"32\", \"40\", \"48\", \"56\", \"64\", \"72\", \"80\", \"104\", \"128\", \"160\", or xs–xl). \"6\" and \"10\" are not tokens and are type errors.","layout.noSpanOrType":"Row, Column and Grid have no span and no type prop. A clickable row is a Button (or a native <button>), and a Grid child spanning columns uses style={{ gridColumn: \"span 2\" }}."},"quality":{"height":"The shell takes the viewport (height=\"100dvh\", never 100vh) and each pane scrolls on its own","panes":"overflowY=\"auto\" on each SplitView panel, never on the SplitView; set labels so the tabs it collapses into below collapseBelow are named","timeline":"Scrubber is a sibling of the SplitView, spanning both panes; onGestureStart pauses playback","toolbar":"IconButtons with tooltips in a Row with borderBottom; one primary action at most"},"mixins":{"CommonProps":{"onBackground":"Colors