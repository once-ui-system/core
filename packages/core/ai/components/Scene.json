  },
  "SceneControls": [
   "none",
   "orbit",
   "turntable"
  ],
  "SceneFrame": {
   "delta": "!number",
   "elapsed": "!number"
  },
  "SceneLabels": {
   "scene": "!string",
   "unavailable": "!string"
  },
  "SceneLighting": [
   "none",
   "neutral",
   "studio"
  ],
  "ScenePointerHandlers": {
   "onClick": "() => void",
   "onPointerEnter": "() => void",
   "onPointerLeave": "() => void"
  },
  "ThreeModule": "typeof import(\"three\")",
  "Vec3": {
   "[key: number]": "number"
  }
 }
