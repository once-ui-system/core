   "target": "Vec3",
   "fov": "number"
  },
  "SceneColor": [
   "string & {}",
   "neutral-strong",
   "neutral-medium",
   "neutral-weak",
   "brand-strong",
   "brand-medium",
   "brand-weak",
   "accent-strong",
   "accent-medium",
   "accent-weak",
   "info-strong",
   "info-medium",
   "info-weak",
   "danger-strong",
   "danger-medium",
   "danger-weak",
   "warning-strong",
   "warning-medium",
   "warning-weak",
   "success-strong",
   "success-medium",
   "success-weak",
   "`--${string}`"
  ],
  "SceneContextValue": {
   "three": "!ThreeModule",
   "scene": "!Three.Scene",
   "camera": "!Three.PerspectiveCamera",
   "renderer": "!Three.WebGLRenderer",
