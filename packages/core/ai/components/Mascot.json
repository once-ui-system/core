{
 "name": "Mascot",
 "group": "modules",
 "mixins": [
  "LeafProps"
 ],
 "props": {
  "state": "MascotState = idle",
  "mood": "MascotMood = neutral",
  "seed": "string | number",
  "accessory": "React.ReactNode",
  "lookAt": "\"pointer\" | \"center\" | { x: number; y: number } = pointer",
  "level": "number",
  "source": "AudioLevelSource | null",
  "size": "\"s\" | \"m\" | \"l\" | \"xl\" | number | CSSUnit = l",
  "aria-label": "string",
  "color": "\"brand\" | \"accent\" | \"neutral\" | (string & {})",
  "roundness": "number",
  "aspect": "number",
  "bodyPath": "string",
  "surface": "\"glossy\" | \"matte\" | \"flat\" | \"glass\"",
  "eyes": "\"tile\" | \"pill\" | \"round\" | \"wide\" | \"dot\" | { path: string }",
  "eyeSize": "number",
  "eyeSpacing": "number",
  "eyeHeight": "number",
  "eyeColor": "string",
  "mouth": "\"none\" | \"smile\" | \"dot\" | \"line\"",
  "brows": "boolean",
  "cheeks": "boolean",
  "personality": "\"calm\" | \"default\" | \"bouncy\""
 },
 "tags": [
  "ai",
  "chat",
  "decoration"
 ],
 "pairsWith": [
  "VoiceVisualizer",
  "WorkingIndicator"
 ],
 "mixinsRef": [
  "LeafProps"
 ],
 "tokensRef": "see tokens.json",
 "resolvedMixins": {
  "LeafProps": {
   "margin": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginTop": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginRight": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginBottom": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginLeft": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginX": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginY": "SpacingToken | number | CSSUnit | \"auto\"",
   "flex": "FlexValue",
   "fillWidth": "boolean",
   "position": "CSSProperties[\"position\"]",
   "top": "SpacingToken | number | CSSUnit",
   "right": "SpacingToken | number | CSSUnit",
   "bottom": "SpacingToken | number | CSSUnit",
   "left": "SpacingToken | number | CSSUnit",
   "className": "string",
   "style": "CSSProperties"
  }
 },
 "types": {
  "AudioLevelSource": [
   "HTMLMediaElement",
   "MediaStream",
   "AnalyserNode"
  ],
  "CSSUnit": [
   "`${number}px`",
   "`${number}rem`",
   "`${number}em`",
   "`${number}ch`",
   "`${number}%`",
   "`${number}vh`",
   "`${number}vw`",
   "`${number}dvh`",
   "`${number}dvw`",
   "`${number}svh`",
   "`${number}svw`",
   "`${number}lvh`",
   "`${number}lvw`",
   "`${number}vmin`",
   "`${number}vmax`",
   "`${number}cqw`",
   "`${number}cqh`",
   "`calc(${string})`",
   "`min(${string})`",
   "`max(${string})`",
   "`clamp(${string})`",
   "`var(${string})`"
  ],
  "MascotMood": [
   "neutral",
   "happy",
   "surprised",
   "sad",
   "skeptical",
   "wink",
   "focused",
   "determined"
  ],
  "MascotState": [
   "idle",
   "listening",
   "thinking",
   "speaking",
   "sleeping"
  ]
 }
}