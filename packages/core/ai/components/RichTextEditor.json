   "paddingTop": "SpacingToken | number | CSSUnit",
   "paddingBottom": "SpacingToken | number | CSSUnit",
   "paddingX": "SpacingToken | number | CSSUnit",
   "paddingY": "SpacingToken | number | CSSUnit",
