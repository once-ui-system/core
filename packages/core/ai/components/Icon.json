{
 "name": "Icon",
 "group": "components",
 "mixins": [
  "LeafProps"
 ],
 "props": {
  "name": "!IconName",
  "onBackground": "`${ColorScheme}-${ColorWeight}`",
  "onSolid": "`${ColorScheme}-${ColorWeight}`",
  "size": "TShirtSizes = m",
  "decorative": "boolean = true",
  "tooltip": "ReactNode",
  "tooltipPosition": "\"top\" | \"bottom\" | \"left\" | \"right\" = top"
 },
 "tags": [
  "basics"
 ],
 "pairsWith": [
  "Row",
  "Button",
  "IconButton"
 ],
 "mixinsRef": [
  "LeafProps"
 ],
 "tokensRef": "see tokens.json",
 "resolvedMixins": {
  "LeafProps": {
   "margin": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginTop": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginRight": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginBottom": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginLeft": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginX": "SpacingToken | number | CSSUnit | \"auto\"",
   "marginY": "SpacingToken | number | CSSUnit | \"auto\"",
   "flex": "FlexValue",
   "fillWidth": "boolean",
   "position": "CSSProperties[\"position\"]",
   "top": "SpacingToken | number | CSSUnit",
   "right": "SpacingToken | number | CSSUnit",
   "bottom": "SpacingToken | number | CSSUnit",
   "left": "SpacingToken | number | CSSUnit",
   "className": "string",
   "style": "CSSProperties"
  }
 },
 "types": {
  "BuiltInIconName": "keyof typeof iconData",
  "ColorScheme": [
   "neutral",
   "brand",
   "accent",
   "info",
   "danger",
   "warning",
   "success"
  ],
  "ColorWeight": [
   "strong",
   "medium",
   "weak"
  ],
  "IconName": "BuiltInIconName | Extract<keyof IconLibraryOverrides, string>",
  "TShirtSizes": [
   "s",
   "xl",
   "l",
   "m",
   "xs"
  ]
 }
}