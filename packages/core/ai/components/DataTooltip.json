{
 "name": "DataTooltip",
 "group": "data",
 "importFrom": "@once-ui-system/core/data",
 "props": {
  "active": "boolean",
  "payload": "readonly Record<string, any>[]",
  "label": "string | number",
  "dataKey": "string = name",
  "DataTooltip": "React.ReactNode",
  "date": "DateConfig = { format: \"MMM d\" }",
  "showSwatches": "boolean = true",
  "variant": "ChartVariant = gradient"
 },
 "tags": [
  "data",
  "chart"
 ],
 "pairsWith": [
  "LineChart",
  "BarChart",
  "Swatch"
 ],
 "mixinsRef": [],
 "types": {
  "ChartVariant": [
   "flat",
   "outline",
   "gradient"
  ],
  "DateConfig": {
   "start": "Date",
   "end": "Date",
   "max": "Date",
   "min": "Date",
   "dual": "boolean",
   "format": "string",
   "presets": "PresetsConfig",
   "selector": "boolean",
   "onChange": "(range: DateRange) => void"
  },
  "DateRange": {
   "startDate": "Date",
   "endDate": "Date"
  },
  "PresetsConfig": {
   "display": "!boolean",
   "granularity": "!\"year\" | \"month\" | \"week\""
  }
 }
}