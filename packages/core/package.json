{
  "name": "@once-ui-system/core",
  "version": "2.6.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "ai",
    "agent",
    "AGENTS.md",
    "scripts/init-agent.js",
    "scripts/validate-ai-code.js"
  ],
  "description": "The open-source, agentic design system for React",
  "keywords": [
    "once-ui",
    "react",
    "nextjs",
    "scss",
    "design system",
    "design framework",
    "nextjs design system",
    "ai",
    "agent",
    "codegen"
  ],
  "author": "Once UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/once-ui-system/core.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/once-ui-system/core/issues"
  },
  "homepage": "https://docs.once-ui.com",
  "onceUi": {
    "harness": "./ai/manifest.json",
    "bootstrap": [
      "./ai/rules.compact.md",
      "./ai/catalog.json"
    ],
    "tasks": "./ai/tasks/index.json",
    "validate": "./scripts/validate-ai-code.js",
    "initAgent": "./scripts/init-agent.js",
    "docs": "https://docs.once-ui.com/once-ui/ai-coding"
  },
  "bin": {
    "once-ui-init-agent": "scripts/init-agent.js",
    "once-ui-validate-ai-code": "scripts/validate-ai-code.js"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.js"
    },
    "./contexts": {
      "types": "./dist/contexts/index.d.ts",
      "import": "./dist/contexts/index.js",
      "require": "./dist/contexts/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js",
      "require": "./dist/modules/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces.d.ts",
      "import": "./dist/interfaces.js",
      "require": "./dist/interfaces.js"
    },
    "./css/styles.css": "./dist/css/styles.css",
    "./css/tokens.css": "./dist/css/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.js"
    },
    "./ai/manifest.json": "./ai/manifest.json",
    "./ai/spec.json": "./ai/spec.json",
    "./ai/catalog.json": "./ai/catalog.json",
    "./ai/tokens.json": "./ai/tokens.json",
    "./ai/functions.json": "./ai/functions.json",
    "./ai/bundles/*": "./ai/bundles/*",
    "./ai/gotchas.json": "./ai/gotchas.json",
    "./ai/rules.compact.md": "./ai/rules.compact.md",
    "./ai/rules.md": "./ai/rules.md",
    "./ai/recipes.md": "./ai/recipes.md",
    "./ai/layouts.md": "./ai/layouts.md",
    "./ai/tasks/*": "./ai/tasks/*",
    "./ai/components/*": "./ai/components/*",
    "./ai/examples/*": "./ai/examples/*",
    "./ai/examples/blocks/*": "./ai/examples/blocks/*",
    "./AGENTS.md": "./AGENTS.md",
    "./data": {
      "types": "./dist/modules/data/index.d.ts",
      "import": "./dist/modules/data/index.js",
      "require": "./dist/modules/data/index.js"
    },
    "./code": {
      "types": "./dist/modules/code/index.d.ts",
      "import": "./dist/modules/code/index.js",
      "require": "./dist/modules/code/index.js"
    },
    "./media": {
      "types": "./dist/modules/media/index.d.ts",
      "import": "./dist/modules/media/index.js",
      "require": "./dist/modules/media/index.js"
    },
    "./map": {
      "types": "./dist/modules/map/index.d.ts",
      "import": "./dist/modules/map/index.js",
      "require": "./dist/modules/map/index.js"
    },
    "./mdx": {
      "types": "./dist/modules/mdx/index.d.ts",
      "import": "./dist/modules/mdx/index.js",
      "require": "./dist/modules/mdx/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm clean && pnpm sync-foundations && pnpm generate-emoji-data && pnpm generate-ai-spec && tsc --project tsconfig.build.json && pnpm copy-files && pnpm build:css && pnpm build:css-modules",
    "sync-foundations": "node scripts/sync-foundations.js scss",
    "build:css": "node scripts/sync-foundations.js css",
    "build:css-modules": "node scripts/compile-css-modules.js",
    "copy-files": "node scripts/copy-files.js",
    "clean": "rimraf dist",
    "prepare": "pnpm build",
    "lint": "biome check .",
    "lint:gate": "node scripts/lint-gate.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "check:package": "publint && attw --pack .",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch --preserveWatchOutput",
    "prepack": "pnpm build",
    "generate-emoji-data": "node scripts/generate-emoji-data.js",
    "refresh-emoji-data": "node scripts/generate-emoji-data.js --refresh",
    "generate-ai-spec": "node scripts/generate-ai-spec.js",
    "init-agent": "node scripts/init-agent.js",
    "validate-ai-code": "node scripts/validate-ai-code.js",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0"
  },
  "peerDependencies": {
    "compressorjs": "^1.3.0",
    "next": ">=15.5",
    "prismjs": "^1.30.0",
    "react": ">=18",
    "react-dom": ">=18",
    "maplibre-gl": "^5.0.0 || ^6.0.0",
    "recharts": "^3.10.1",
    "sass": "^1.77.6"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "sass": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "prismjs": {
      "optional": true
    },
    "compressorjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.6",
    "@once-ui-system/foundations": "workspace:*",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/ui": "^4.1.12",
    "axe-core": "^4.10.3",
    "jsdom": "^30.0.0",
    "maplibre-gl": "^6.15.0",
    "publint": "^0.3.23",
    "react-icons": "^5.7.0",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
