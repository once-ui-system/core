  "scripts": {
    "build": "pnpm clean && pnpm sync-foundations && pnpm generate-emoji-data && pnpm generate-ai-spec && tsc --project tsconfig.build.json && pnpm copy-files && pnpm build:css && pnpm build:css-modules",
    "sync-foundations": "node scripts/sync-foundations.cjs scss",
    "build:css": "node scripts/sync-foundations.cjs css",
    "build:css-modules": "node scripts/compile-css-modules.cjs",
    "copy-files": "node scripts/copy-files.cjs",
    "clean": "rimraf dist",
    "prepare": "pnpm build",
    "lint": "biome check .",
    "lint:gate": "node scripts/lint-gate.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./css/styles.css ./css/tokens.css ./AGENTS.md ./ai/rules.compact.md ./ai/rules.md ./ai/recipes.md ./ai/layouts.md",
    "test:watch": "vitest",
    "check:size": "node scripts/bundle-size.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "prepack": "pnpm build",
    "generate-emoji-data": "node scripts/generate-emoji-data.cjs",
    "refresh-emoji-data": "node scripts/generate-emoji-data.cjs --refresh",
    "generate-ai-spec": "node scripts/generate-ai-spec.cjs",
    "init-agent": "node scripts/init-agent.cjs",
    "validate-ai-code": "node scripts/validate-ai-code.cjs",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
