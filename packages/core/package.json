{
  "name": "@once-ui-system/core",
  "version": "2.1.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "ai",
    "!ai/catalog.seed.json",
    "!ai/eval-tasks.md",
    "agent",
    "AGENTS.md",
    "scripts/init-agent.cjs",
    "scripts/validate-ai-code.cjs"
  ],
  "description": "Once UI for Next.js NPM package",
  "keywords": [
    "once-ui",
    "react",
    "nextjs",
    "scss",
    "design system",
    "design framework",
    "nextjs design system",
    "ai",
    "agent",
    "codegen"
  ],
  "author": "Once UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/once-ui-system/core.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/once-ui-system/core/issues"
  },
  "homepage": "https://docs.once-ui.com",
  "onceUi": {
    "harness": "./ai/manifest.json",
    "bootstrap": [
      "./ai/rules.compact.md",
      "./ai/catalog.json"
    ],
    "tasks": "./ai/tasks/index.json",
    "validate": "./scripts/validate-ai-code.cjs",
    "initAgent": "./scripts/init-agent.cjs",
    "docs": "https://docs.once-ui.com/once-ui/ai-coding"
  },
  "type": "module",
  "bin": {
    "once-ui-init-agent": "./scripts/init-agent.cjs",
    "once-ui-validate-ai-code": "./scripts/validate-ai-code.cjs"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css/styles.css": "./dist/css/styles.css",
    "./css/tokens.css": "./dist/css/tokens.css",
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./ai/manifest.json": "./ai/manifest.json",
    "./ai/spec.json": "./ai/spec.json",
    "./ai/catalog.json": "./ai/catalog.json",
    "./ai/tokens.json": "./ai/tokens.json",
    "./ai/functions.json": "./ai/functions.json",
    "./ai/bundles/*": "./ai/bundles/*",
    "./ai/gotchas.json": "./ai/gotchas.json",
    "./ai/rules.compact.md": "./ai/rules.compact.md",
    "./ai/rules.md": "./ai/rules.md",
    "./ai/recipes.md": "./ai/recipes.md",
    "./ai/layouts.md": "./ai/layouts.md",
    "./ai/tasks/*": "./ai/tasks/*",
    "./ai/components/*": "./ai/components/*",
    "./ai/examples/*": "./ai/examples/*",
    "./ai/examples/blocks/*": "./ai/examples/blocks/*",
    "./AGENTS.md": "./AGENTS.md",
    "./data": {
      "types": "./dist/modules/data/index.d.ts",
      "default": "./dist/modules/data/index.js"
    },
    "./code": {
      "types": "./dist/modules/code/index.d.ts",
      "default": "./dist/modules/code/index.js"
    },
    "./emoji": {
      "types": "./dist/modules/emoji/index.d.ts",
      "default": "./dist/modules/emoji/index.js"
    },
    "./media": {
      "types": "./dist/modules/media/index.d.ts",
      "default": "./dist/modules/media/index.js"
    },
    "./mdx": {
      "types": "./dist/modules/mdx/index.d.ts",
      "default": "./dist/modules/mdx/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm clean && pnpm sync-foundations && pnpm generate-emoji-data && pnpm generate-ai-spec && tsc --project tsconfig.build.json && pnpm copy-files && pnpm build:css && pnpm build:css-modules",
    "sync-foundations": "node scripts/sync-foundations.cjs scss",
    "build:css": "node scripts/sync-foundations.cjs css",
    "build:css-modules": "node scripts/compile-css-modules.cjs",
    "copy-files": "node scripts/copy-files.cjs",
    "clean": "rimraf dist",
    "prepare": "pnpm build",
    "lint": "biome check .",
    "lint:gate": "node scripts/lint-gate.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./css/styles.css ./css/tokens.css ./AGENTS.md ./ai/rules.compact.md ./ai/rules.md ./ai/recipes.md ./ai/layouts.md",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "prepack": "pnpm build",
    "generate-emoji-data": "node scripts/generate-emoji-data.cjs",
    "refresh-emoji-data": "node scripts/generate-emoji-data.cjs --refresh",
    "generate-ai-spec": "node scripts/generate-ai-spec.cjs",
    "init-agent": "node scripts/init-agent.cjs",
    "validate-ai-code": "node scripts/validate-ai-code.cjs",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0"
  },
  "peerDependencies": {
    "compressorjs": "^1.3.0",
    "next": ">=15.5",
    "prismjs": "^1.30.0",
    "react": ">=19",
    "react-dom": ">=19",
    "recharts": "^3.10.1"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "prismjs": {
      "optional": true
    },
    "compressorjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.6",
    "@once-ui-system/foundations": "workspace:*",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/ui": "^4.1.10",
    "axe-core": "^4.10.3",
    "jsdom": "^30.0.0",
    "publint": "^0.3.23",
    "react-icons": "^5.7.0",
    "rimraf": "^6.1.3",
    "sass": "^1.77.6",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
