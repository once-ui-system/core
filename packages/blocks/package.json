{
  "name": "@once-ui-system/blocks",
  "version": "2.1.0",
  "private": true,
  "description": "Once UI blocks: Banner, Book, LogoCloud, ScrollToTop, StylePanel and StyleOverlay, compositions on top of @once-ui-system/core.",
  "keywords": [
    "once-ui",
    "react",
    "nextjs",
    "design system",
    "blocks",
    "compositions"
  ],
  "author": "Once UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/once-ui-system/core.git",
    "directory": "packages/blocks"
  },
  "bugs": {
    "url": "https://github.com/once-ui-system/core/issues"
  },
  "homepage": "https://docs.once-ui.com",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm clean && tsc --project tsconfig.build.json && node ../core/scripts/compile-css-modules.cjs --root .",
    "clean": "rimraf dist",
    "dev": "node ../core/scripts/dev.mjs --root .",
    "prepare": "pnpm build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@once-ui-system/core": "^3.0.0-0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.6",
    "@once-ui-system/core": "workspace:*",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "^4.10.3",
    "jsdom": "^30.0.0",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
